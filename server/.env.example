# Video Provider selection: 'ltx-2.3' (default), 'gemini-omni-1.2-flash', or 'mock'
VIDEO_PROVIDER=mock

# Secret key for signing sessions and CSRF
SESSION_SECRET=change-this-to-a-secure-random-secret-key-in-production

# External AI API keys (optional in mock mode)
ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# ① Google AI Studio (API 키 발급: https://aistudio.google.com/app/apikey)
#GOOGLE_GENAI_USE_VERTEXAI=FALSE
#GOOGLE_API_KEY=your_google_api_key_here
#GEMINI_API_KEY=your_gemini_api_key_here

# ② Vertex AI (GCP 프로젝트, gcloud auth application-default login 필요)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global
# Vertex AI Express Mode (AQ. 로 시작하는 키는 Vertex AI Express Mode 전용 키입니다)

#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
#GOOGLE_CLOUD_LOCATION=global
#GOOGLE_API_KEY=your_vertex_api_key_here
#GEMINI_API_KEY=your_vertex_api_key_here

# 사용할 Gemini 모델
ADK_MODEL=gemini-3.8-flash
# Local LTX-2.3 ComfyUI URL
LTX_COMFYUI_URL=http://127.0.0.1:8188

# Celery broker and result backend URL
REDIS_URL=redis://localhost:6379/0

# Database URL (MySQL 9.3 default for Docker / production)
DATABASE_URL=mysql+pymysql://movie_user:movie_password@localhost:3306/movie_agent?charset=utf8mb4
# 로컬 개발 시 SQLite 대체 사용 예시:
# DATABASE_URL=sqlite:///./movie_agent.db

# Storage directory for uploaded images and generated video files
STORAGE_DIR=./storage

# SMTP Email Dispatch Settings (이메일 6자리 인증 코드 실제 발송용)
# SMTP_HOST 가 설정되어 있으면 외부 SMTP(예: Gmail, Naver, 회사 메일서버)로 실제 발송됩니다.
# SMTP_HOST 가 비어 있으면 내장된 Python aiosmtpd 메일 서버(포트 1025) 및 웹 수신함으로 전달됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moviemaker.local
SMTP_TLS=TRUE

# Python aiosmtpd 내장 메일 서버 설정
MAIL_SERVER_ENABLED=TRUE
MAIL_SERVER_HOST=0.0.0.0
MAIL_SERVER_PORT=1025

